# Production template. Populate through your host's secret manager; never commit .env.
GANIT_DOMAIN=ganit.example.org
GANIT_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@MANAGED_HOST:5432/ganit?sslmode=verify-full
GANIT_PUBLIC_URL=https://ganit.example.org
GANIT_ALLOWED_ORIGINS=https://ganit.example.org
# Exact source address of the private TLS proxy; never 0.0.0.0/0.
GANIT_TRUSTED_PROXY_CIDRS=172.31.98.2/32
# Generate with: python server/manage.py generate-key
GANIT_LEASE_SIGNING_KEY=REPLACE_WITH_PRIVATE_BASE64URL_ED25519_KEY
GANIT_COOKIE_SAMESITE=Lax
GANIT_ACCESS_TTL=900
GANIT_REFRESH_TTL=2592000
GANIT_OFFLINE_TTL=604800
GANIT_OFFLINE_AFTER=90
GANIT_SSE_INTERVAL=2

# Select classroom or dashboard for separate Vercel projects; auto preserves local combined mode.
GANIT_APP_SURFACE=auto

# Optional read-only sample dashboard, available only to authenticated super admins.
# Keep disabled on the classroom deployment. Seed an isolated schema explicitly.
GANIT_PRESENTATION_ENABLED=0
GANIT_PRESENTATION_SCHEMA=ganit_presentation
